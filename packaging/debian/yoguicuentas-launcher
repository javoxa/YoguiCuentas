#!/bin/sh
set -eu

APP_DIR=/opt/yoguicuentas
VENV_DIR=/var/lib/yoguicuentas/.venv-portable
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/yoguicuentas"

if [ ! -x "$VENV_DIR/bin/python" ]; then
    echo "Falta el entorno de YoguiCuentas. Reinstalá el paquete yoguicuentas." >&2
    exit 1
fi

mkdir -p "$DATA_DIR/resultados"
cd "$APP_DIR"
exec env -u CUDA_VISIBLE_DEVICES "$VENV_DIR/bin/python" -m yoguicuentas.launcher "$@" --output "$DATA_DIR/resultados"
